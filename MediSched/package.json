{
  "name": "medisched-portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/build.js",
    "build:production": "node tools/build.js --production",
    "serve": "node tools/serve.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.cjs",
    "test:database": "node --test --test-concurrency=1 tests/postgres.integration.js tests/staff-postgres.integration.js tests/z-checkin-analytics-postgres.integration.js",
    "test:supabase": "node --test tests/supabase.integration.js",
    "test:mobile": "node tests/mobile.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3"
  },
  "devDependencies": {
    "pg": "8.16.3",
    "playwright": "1.56.1"
  }
}
